NEXT_PUBLIC_BASE_URL=http://localhost:3000

NEXT_PUBLIC_SANITY_PROJECT_ID=s7yacqk1
NEXT_PUBLIC_SANITY_DATASET=production
NEXT_PUBLIC_SANITY_API_VERSION=2024-12-01
NEXT_PUBLIC_SANITY_STUDIO_URL=http://localhost:3333

# Required to start and build the frontend. Use a Viewer token: Sanity Live
# can send it to browsers during authenticated preview sessions.
SANITY_API_READ_TOKEN=
# Required only for film submissions. Keep this token server-only.
SANITY_API_WRITE_TOKEN=

# Optional server-only token for GitHub stargazer data.
# Replaces the previous NEXT_PUBLIC_GITHUB_TOKEN variable.
GITHUB_TOKEN=

# Optional comma-separated hostnames/IPs for additional local dev origins.
# Local network addresses and this computer's hostname are detected automatically.
# NEXT_ALLOWED_DEV_ORIGINS=

# Sample festival events are shown only in local development. Set false to hide.
# FESTIVAL_MOCK_EVENTS=false
